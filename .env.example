# Sao chép file này thành ".env" khi chạy local, hoặc set trực tiếp trên Fly.io bằng:
#   flyctl secrets set TELEGRAM_BOT_TOKEN=xxx TELEGRAM_CHAT_ID=xxx -a fitandcare-web
#
# Lấy TELEGRAM_BOT_TOKEN: tạo bot qua @BotFather trên Telegram (/newbot), copy token được cấp.
# Lấy TELEGRAM_CHAT_ID: admin nhắn tin bất kỳ cho bot vừa tạo, sau đó mở
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# và đọc giá trị "chat":{"id": ...}
#
# Có thể điền nhiều chat_id (nhiều admin cùng nhận thông báo), cách nhau bằng dấu phẩy:
#   TELEGRAM_CHAT_ID=111111111,222222222
#
# --- Lệnh bot (/start, /help) ---
# Bot chỉ trả lời được /start, /help sau khi đăng ký webhook 1 LẦN DUY NHẤT
# (chạy sau khi đã set TELEGRAM_BOT_TOKEN và đã deploy site lên Fly.io):
#
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://fitandcare-web.fly.dev/api/telegram-webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>"
#
# TELEGRAM_WEBHOOK_SECRET (tùy chọn, nên có) là 1 chuỗi bí mật tự đặt (vd: chuỗi random 32 ký tự)
# để chặn người khác giả mạo gọi vào /api/telegram-webhook. Phải khớp với giá trị set ở bước trên.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
PORT=8080

# --- VNPay (thanh toán thẻ) ---
# Chưa điền VNP_TMN_CODE + VNP_HASH_SECRET -> hệ thống TỰ ĐỘNG chạy ở chế độ DEMO
# (mô phỏng trang thanh toán tại /mock-vnpay.html, không phải VNPay thật, an toàn để test).
#
# Khi công ty có tài khoản merchant VNPay thật, chỉ cần điền 2 giá trị dưới đây rồi deploy lại
# (KHÔNG cần sửa code) là chuyển sang thanh toán thật ngay:
#   flyctl secrets set VNP_TMN_CODE=xxx VNP_HASH_SECRET=xxx -a fitandcare-web
#
# VNP_URL: mặc định là sandbox VNPay để test. Khi lên thật, đổi thành:
#   https://vnpayment.vn/paymentv2/vpcpay.html
# PUBLIC_BASE_URL: domain public của site (VNPay redirect khách về đây sau khi thanh toán).
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
PUBLIC_BASE_URL=https://fitandcare-web.fly.dev

# --- Thông tin chuyển khoản ngân hàng (hiển thị cho khách) ---
# Đây là dữ liệu MẪU, cần thay bằng STK thật của công ty trước khi nhận thanh toán thật:
#   flyctl secrets set BANK_NAME="Ngan hang ABC" BANK_ACCOUNT_NUMBER=xxx BANK_ACCOUNT_HOLDER="TEN CONG TY" -a fitandcare-web
BANK_NAME=Ngân hàng TMCP Á Châu (ACB) - Chi nhánh Sài Gòn
BANK_ACCOUNT_NUMBER=123456789
BANK_ACCOUNT_HOLDER=CONG TY TNHH FIT AND CARE

# --- Zalo Bot (FIT AND CARE Assistant - MVP, chưa AI/RAG) ---
# Bot chạy trên "Zalo Bot Platform" (Bot Creator), KHÔNG PHẢI Zalo Official Account.
#
# Lấy ZALO_BOT_TOKEN:
#   1. Mở Zalo, tìm OA "Zalo Bot Manager".
#   2. Trong khung chat, chọn "Tạo bot" -> mở app Zalo Bot Creator.
#   3. Đặt tên bot (bắt buộc bắt đầu bằng "Bot", vd: "Bot FIT AND CARE") rồi tạo.
#   4. Zalo Bot Manager sẽ nhắn "Thông tin Bot" + Bot Token trực tiếp về Zalo cá nhân của bạn.
#   5. Copy token đó, dán vào ZALO_BOT_TOKEN bên dưới (local) hoặc set secret trên Fly.io:
#        flyctl secrets set ZALO_BOT_TOKEN=xxx ZALO_BOT_WEBHOOK_SECRET=xxx -a fitandcare-web
#
# ZALO_BOT_WEBHOOK_SECRET: BẮT BUỘC theo API setWebhook của Zalo (8-256 ký tự, tự đặt,
# vd chuỗi random 32 ký tự) — dùng để xác thực các request Zalo gọi vào /api/zalo-webhook
# qua header "X-Bot-Api-Secret-Token".
#
# Sau khi đã set 2 biến trên và DEPLOY site lên Fly.io, đăng ký webhook 1 LẦN DUY NHẤT:
#
#   curl -X POST "https://bot-api.zaloplatforms.com/bot<ZALO_BOT_TOKEN>/setWebhook" \
#     -H "Content-Type: application/json" \
#     -d '{"url":"https://fitandcare-web.fly.dev/api/zalo-webhook","secret_token":"<ZALO_BOT_WEBHOOK_SECRET>"}'
#
# Kiểm tra lại đã đăng ký đúng chưa:
#   curl -X POST "https://bot-api.zaloplatforms.com/bot<ZALO_BOT_TOKEN>/getWebhookInfo"
ZALO_BOT_TOKEN=
ZALO_BOT_WEBHOOK_SECRET=
